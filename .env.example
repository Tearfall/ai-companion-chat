# Tried in this order on every request; a provider is skipped if its key is blank, and the next one
# is tried automatically whenever a request fails (rate limit, retired model, timeout, empty reply).
# Set at least one. Cerebras is first because its free tier is the biggest (1M tokens/day, but only
# 5 requests/minute); Groq allows 200k tokens/day; OpenRouter's free models are a last resort.
# Free model names get retired now and then: if a provider keeps failing in the server log with
# "model not found", check its model list and update the *_MODEL line.
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_MODEL=gpt-oss-120b

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

PORT=3000
